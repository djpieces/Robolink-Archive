			<div class="vc_single_image-wrapper   vc_box_border_grey"><img decoding="async" width="895" height="426" src="https://archive.learn.robolink.com/wp-content/uploads/2020/11/Viking-Ship-Bot-Backbone1-895x426.jpg" class="vc_single_image-img attachment-large" alt="Viking Ship Bot Backbone1" title="Viking Ship Bot Backbone1" srcset="https://archive.learn.robolink.com/wp-content/uploads/2020/11/Viking-Ship-Bot-Backbone1.jpg 895w, https://archive.learn.robolink.com/wp-content/uploads/2020/11/Viking-Ship-Bot-Backbone1-300x143.jpg 300w, https://archive.learn.robolink.com/wp-content/uploads/2020/11/Viking-Ship-Bot-Backbone1-630x300.jpg 630w" sizes="(max-width: 895px) 100vw, 895px" /></div>
		</figure>
	</div>

	<div  class="wpb_single_image wpb_content_element vc_align_center wpb_content_element">
		
		<figure class="wpb_wrapper vc_figure">
			<div class="vc_single_image-wrapper   vc_box_border_grey"><img decoding="async" width="889" height="427" src="https://archive.learn.robolink.com/wp-content/uploads/2020/11/Viking-Ship-Bot-Backbone2-889x427.jpg" class="vc_single_image-img attachment-large" alt="Viking Ship Bot Backbone2" title="Viking Ship Bot Backbone2" srcset="https://archive.learn.robolink.com/wp-content/uploads/2020/11/Viking-Ship-Bot-Backbone2.jpg 889w, https://archive.learn.robolink.com/wp-content/uploads/2020/11/Viking-Ship-Bot-Backbone2-300x144.jpg 300w" sizes="(max-width: 889px) 100vw, 889px" /></div>
